# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — server-only, never expose to the client. Used for admin
# writes (view/applied counters, cron sync) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for absolute links in push notifications, sitemaps, etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only this email can access /admin, even if logged in via public signup.
ADMIN_EMAIL=careerwithkumar@gmail.com

# Resend (transactional email — booking notifications to the admin).
RESEND_API_KEY=your-resend-api-key

# Web Push (VAPID). Generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@careerwithkumar.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
